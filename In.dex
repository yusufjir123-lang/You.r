<!DOCTYPE html>
<html lang="so">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Yusuf Chat</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --green:#00a884;
  --dark:#111b21;
  --dark2:#202c33;
  --dark3:#2a3942;
  --light:#f0f2f5;
  --white:#fff;
  --text:#111;
  --muted:#667781;
  --bubble:#d9fdd3;
}
body{
  font-family:Arial,Helvetica,sans-serif;
  background:#d9dbd5;
  color:var(--text);
  height:100vh;
  overflow:hidden
}
button,input,textarea{font:inherit}
button{cursor:pointer;border:0}
.app{
  width:100%;
  height:100vh;
  display:flex;
  background:#fff;
}
.sidebar{
  width:380px;
  min-width:320px;
  border-right:1px solid #ddd;
  display:flex;
  flex-direction:column;
  background:#fff;
}
.top{
  height:64px;
  background:#f0f2f5;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 16px;
}
.avatar{
  width:42px;
  height:42px;
  border-radius:50%;
  background:var(--green);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  overflow:hidden;
  flex-shrink:0
}
.avatar img{width:100%;height:100%;object-fit:cover}
.top-actions{
  display:flex;
  gap:8px
}
.icon{
  width:40px;
  height:40px;
  border-radius:50%;
  background:transparent;
  font-size:21px;
  color:#54656f
}
.icon:hover{background:#dfe3e5}
.search{
  padding:8px 12px;
  background:#fff;
}
.searchbox{
  height:40px;
  background:#f0f2f5;
  border-radius:8px;
  display:flex;
  align-items:center;
  padding:0 12px;
  gap:10px
}
.searchbox input{
  width:100%;
  border:0;
  outline:0;
  background:transparent;
}
.tabs{
  display:flex;
  height:50px;
  border-bottom:1px solid #ddd
}
.tabs button{
  flex:1;
  background:#fff;
  color:#667781;
  font-weight:bold;
  border-bottom:3px solid transparent
}
.tabs button.active{
  color:var(--green);
  border-color:var(--green)
}
.list{
  overflow-y:auto;
  flex:1
}
.chat-item{
  height:72px;
  padding:10px 14px;
  display:flex;
  align-items:center;
  gap:12px;
  border-bottom:1px solid #eee;
  cursor:pointer
}
.chat-item:hover{background:#f5f6f6}
.chat-item.active{background:#ebebeb}
.chat-info{
  min-width:0;
  flex:1
}
.chat-row{
  display:flex;
  justify-content:space-between;
  gap:10px
}
.chat-name{
  font-weight:bold;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}
.chat-time{
  font-size:12px;
  color:#667781;
  white-space:nowrap
}
.last{
  color:#667781;
  font-size:14px;
  margin-top:5px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}
.badge{
  background:var(--green);
  color:#fff;
  border-radius:20px;
  min-width:20px;
  height:20px;
  padding:2px 6px;
  font-size:11px;
  display:inline-flex;
  align-items:center;
  justify-content:center
}
.empty{
  padding:40px 20px;
  text-align:center;
  color:#667781
}

/* MAIN CHAT */
.main{
  flex:1;
  display:flex;
  flex-direction:column;
  min-width:0;
  background:#efeae2;
  position:relative
}
.chat-header{
  height:64px;
  background:#f0f2f5;
  display:flex;
  align-items:center;
  padding:8px 14px;
  gap:10px;
  border-bottom:1px solid #ddd
}
.back{
  display:none
}
.header-info{
  flex:1;
  min-width:0
}
.header-name{
  font-weight:bold
}
.header-status{
  color:#667781;
  font-size:13px;
  margin-top:3px
}
.messages{
  flex:1;
  overflow-y:auto;
  padding:20px 7%;
  background:
  radial-gradient(#ddd 1px,transparent 1px);
  background-size:30px 30px;
  background-color:#efeae2
}
.day{
  text-align:center;
  margin:10px 0 18px
}
.day span{
  background:#fff;
  color:#667781;
  padding:7px 12px;
  border-radius:8px;
  font-size:12px;
  box-shadow:0 1px 1px #ddd
}
.message{
  display:flex;
  margin:5px 0;
  position:relative
}
.message.me{justify-content:flex-end}
.bubble{
  max-width:70%;
  padding:7px 9px 5px;
  border-radius:8px;
  background:#fff;
  box-shadow:0 1px 1px #ddd;
  position:relative
}
.me .bubble{background:var(--bubble)}
.text{
  white-space:pre-wrap;
  word-break:break-word;
  padding-right:35px
}
.meta{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:3px;
  margin-top:3px;
  color:#667781;
  font-size:10px
}
.ticks.read{color:#53bdeb}
.msg-image{
  width:280px;
  max-width:100%;
  max-height:300px;
  object-fit:cover;
  border-radius:7px;
  display:block
}
.file-card{
  background:#f0f2f5;
  border-radius:7px;
  padding:10px;
  display:flex;
  align-items:center;
  gap:10px
}
.reply{
  border-left:4px solid var(--green);
  background:rgba(0,0,0,.06);
  padding:5px 8px;
  border-radius:4px;
  margin-bottom:5px;
  font-size:12px
}
.reply b{display:block;color:var(--green)}
.input-area{
  background:#f0f2f5;
  min-height:62px;
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px 12px
}
.message-input{
  flex:1;
  background:#fff;
  border-radius:9px;
  min-height:42px;
  max-height:120px;
  border:0;
  outline:0;
  padding:11px 14px;
  resize:none
}
.send{
  width:44px;
  height:44px;
  border-radius:50%;
  background:var(--green);
  color:#fff;
  font-size:20px
}
.record{
  background:#54656f
}
.record.recording{
  background:#d93025
}
.reply-bar{
  background:#fff;
  padding:8px 14px;
  border-left:4px solid var(--green);
  display:none;
  justify-content:space-between
}

/* MENU */
.menu{
  position:absolute;
  z-index:50;
  background:#fff;
  box-shadow:0 4px 18px rgba(0,0,0,.25);
  border-radius:8px;
  overflow:hidden;
  display:none;
  min-width:180px
}
.menu button{
  width:100%;
  padding:11px 15px;
  text-align:left;
  background:#fff
}
.menu button:hover{background:#f0f2f5}

/* MODAL */
.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100
}
.modal{
  width:min(500px,92%);
  max-height:90vh;
  overflow:auto;
  background:#fff;
  border-radius:12px;
  box-shadow:0 10px 40px rgba(0,0,0,.3)
}
.modal-head{
  padding:18px;
  border-bottom:1px solid #ddd;
  display:flex;
  justify-content:space-between;
  align-items:center
}
.modal-body{padding:18px}
.modal input,.modal textarea{
  width:100%;
  border:1px solid #ddd;
  border-radius:7px;
  padding:11px;
  outline:0;
  margin:7px 0 14px
}
.primary{
  background:var(--green);
  color:#fff;
  padding:11px 18px;
  border-radius:7px
}
.secondary{
  background:#eee;
  padding:11px 18px;
  border-radius:7px
}
.form-row{
  display:flex;
  gap:10px;
  justify-content:flex-end
}

/* EMOJI */
.emoji-panel{
  position:absolute;
  bottom:68px;
  left:10px;
  width:330px;
  max-height:250px;
  overflow:auto;
  background:#fff;
  box-shadow:0 5px 25px rgba(0,0,0,.25);
  border-radius:10px;
  padding:10px;
  display:none;
  z-index:30
}
.emoji-panel button{
  background:transparent;
  font-size:24px;
  padding:6px
}

/* STATUS */
.status-circle{
  border:3px solid var(--green);
  width:50px;
  height:50px;
  border-radius:50%;
  padding:2px
}
.status-circle .avatar{
  width:100%;
  height:100%
}
.status-item{
  padding:12px 15px;
  display:flex;
  gap:12px;
  align-items:center;
  cursor:pointer
}
.status-item:hover{background:#f5f5f5}

/* CALL */
.call-item{
  padding:14px;
  display:flex;
  align-items:center;
  gap:12px;
  border-bottom:1px solid #eee
}
.call-icon{font-size:22px}

/* LOCK */
.lock{
  position:fixed;
  inset:0;
  background:#111b21;
  color:#fff;
  z-index:500;
  display:flex;
  align-items:center;
  justify-content:center
}
.lock-box{
  width:min(360px,90%);
  text-align:center
}
.lock-logo{
  width:80px;
  height:80px;
  border-radius:50%;
  background:var(--green);
  margin:0 auto 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:40px
}
.lock input{
  width:100%;
  padding:14px;
  margin:15px 0;
  border:0;
  border-radius:8px;
  text-align:center;
  outline:0
}

/* PROFILE */
.profile{
  text-align:center
}
.big-avatar{
  width:110px;
  height:110px;
  border-radius:50%;
  margin:10px auto 20px;
  background:var(--green);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42px;
  overflow:hidden
}
.big-avatar img{
  width:100%;
  height:100%;
  object-fit:cover
}

/* SETTINGS */
.setting{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 0;
  border-bottom:1px solid #eee
}
.switch{
  width:45px;
  height:24px;
  background:#aaa;
  border-radius:20px;
  position:relative
}
.switch:after{
  content:"";
  width:20px;
  height:20px;
  background:#fff;
  position:absolute;
  top:2px;
  left:2px;
  border-radius:50%;
  transition:.2s
}
.switch.on{background:var(--green)}
.switch.on:after{left:23px}

/* TOAST */
.toast{
  position:fixed;
  bottom:80px;
  left:50%;
  transform:translateX(-50%);
  background:#222;
  color:#fff;
  padding:11px 17px;
  border-radius:8px;
  z-index:999;
  display:none
}

/* DARK */
body.dark{
  background:#0b141a;
  color:#e9edef
}
.dark .sidebar,
.dark .modal,
.dark .emoji-panel{background:#111b21;color:#e9edef}
.dark .top,
.dark .chat-header,
.dark .input-area{background:#202c33}
.dark .searchbox,
.dark .message-input{background:#2a3942;color:#fff}
.dark .chat-item{border-color:#202c33}
.dark .chat-item:hover,.dark .chat-item.active{background:#202c33}
.dark .tabs button{background:#111b21;color:#8696a0}
.dark .tabs button.active{color:#00a884}
.dark .last,.dark .chat-time,.dark .header-status{color:#8696a0}
.dark .messages{background-color:#0b141a}
.dark .bubble{background:#202c33;color:#e9edef}
.dark .me .bubble{background:#005c4b}
.dark .day span{background:#182229;color:#8696a0}
.dark .modal input,.dark .modal textarea{background:#2a3942;color:#fff;border-color:#40505a}
.dark .secondary{background:#2a3942;color:#fff}
.dark .menu,.dark .menu button{background:#233038;color:#fff}
.dark .menu button:hover{background:#2a3942}
.dark .file-card{background:#2a3942}
.dark .setting{border-color:#2a3942}

/* MOBILE */
@media(max-width:750px){
  .sidebar{
    width:100%;
    min-width:0
  }
  .main{
    display:none
  }
  .app.chat-open .sidebar{display:none}
  .app.chat-open .main{display:flex}
  .back{display:block}
  .messages{padding:15px 4%}
  .bubble{max-width:85%}
}
</style>
</head>

<body>

<!-- LOCK -->
<div class="lock" id="lockScreen">
  <div class="lock-box">
    <div class="lock-logo">💬</div>
    <h2>Yusuf Chat</h2>
    <p style="margin-top:8px;color:#aebac1">Geli magacaaga si aad u bilowdo</p>
    <input id="loginName" placeholder="Magacaaga">
    <input id="loginPin" type="password" maxlength="6" placeholder="PIN (ikhtiyaari)">
    <button class="primary" style="width:100%" onclick="startApp()">Bilow</button>
  </div>
</div>

<div class="app" id="app">

<!-- SIDEBAR -->
<aside class="sidebar">

  <div class="top">
    <div class="avatar" id="myAvatar">Y</div>

    <div class="top-actions">
      <button class="icon" onclick="openProfile()" title="Profile">👤</button>
      <button class="icon" onclick="openNewChat()" title="New chat">✏️</button>
      <button class="icon" onclick="openSettings()" title="Settings">⋮</button>
    </div>
  </div>

  <div class="search">
    <div class="searchbox">
      🔍
      <input id="searchInput" placeholder="Raadi chat ama qof..." oninput="searchChats()">
    </div>
  </div>

  <div class="tabs">
    <button class="active" onclick="showTab('chats',this)">Chats</button>
    <button onclick="showTab('status',this)">Status</button>
    <button onclick="showTab('calls',this)">Calls</button>
  </div>

  <div class="list" id="sideList"></div>

</aside>

<!-- MAIN -->
<main class="main">

  <div class="chat-header">
    <button class="icon back" onclick="closeChat()">‹</button>

    <div class="avatar" id="headerAvatar">?</div>

    <div class="header-info">
      <div class="header-name" id="headerName">Dooro chat</div>
      <div class="header-status" id="headerStatus">online</div>
    </div>

    <button class="icon" onclick="startVideoCall()">📹</button>
    <button class="icon" onclick="startVoiceCall()">📞</button>
    <button class="icon" onclick="toggleChatMenu()">⋮</button>
  </div>

  <div class="messages" id="messages">
    <div class="empty">
      <h2>💬 Yusuf Chat</h2>
      <p>Dooro qof si aad u bilowdo wada sheekaysiga.</p>
    </div>
  </div>

  <div class="reply-bar" id="replyBar">
    <div>
      <b style="color:#00a884">Reply</b>
      <div id="replyText"></div>
    </div>
    <button onclick="cancelReply()">✕</button>
  </div>

  <div class="emoji-panel" id="emojiPanel"></div>

  <div class="input-area">
    <button class="icon" onclick="toggleEmoji()">😊</button>

    <button class="icon" onclick="document.getElementById('fileInput').click()">📎</button>

    <input id="fileInput" type="file" multiple hidden onchange="handleFiles(event)">

    <textarea
      id="messageInput"
      class="message-input"
      rows="1"
      placeholder="Qor fariin..."
      onkeydown="handleEnter(event)"
    ></textarea>

    <button class="send" id="sendButton" onclick="sendMessage()">➤</button>
    <button class="send record" id="recordButton" onclick="toggleRecording()">🎙️</button>
  </div>

  <div class="menu" id="chatMenu">
    <button onclick="pinCurrent()">📌 Pin chat</button>
    <button onclick="muteCurrent()">🔕 Mute chat</button>
    <button onclick="clearCurrent()">🧹 Clear messages</button>
    <button onclick="deleteCurrent()">🗑️ Delete chat</button>
    <button onclick="openProfile()">👤 View profile</button>
  </div>

</main>
</div>

<!-- NEW CHAT -->
<div class="overlay" id="newChatModal">
  <div class="modal">
    <div class="modal-head">
      <h3>New Contact</h3>
      <button onclick="closeModal('newChatModal')">✕</button>
    </div>
    <div class="modal-body">
      <label>Magaca</label>
      <input id="newName" placeholder="Tusaale: Ahmed">

      <label>Number</label>
      <input id="newNumber" placeholder="+252...">

      <label>About</label>
      <input id="newAbout" placeholder="Hello! I am using Yusuf Chat">

      <div class="form-row">
        <button class="secondary" onclick="closeModal('newChatModal')">Cancel</button>
        <button class="primary" onclick="createContact()">Save Contact</button>
      </div>
    </div>
  </div>
</div>

<!-- PROFILE -->
<div class="overlay" id="profileModal">
  <div class="modal">
    <div class="modal-head">
      <h3>My Profile</h3>
      <button onclick="closeModal('profileModal')">✕</button>
    </div>

    <div class="modal-body profile">
      <div class="big-avatar" id="profileAvatar">Y</div>

      <input type="file" id="profileImage" accept="image/*" onchange="changeProfileImage(event)">

      <label>Magac</label>
      <input id="profileName">

      <label>About</label>
      <textarea id="profileAbout">Hey! I am using Yusuf Chat.</textarea>

      <button class="primary" onclick="saveProfile()">Save Profile</button>
    </div>
  </div>
</div>

<!-- SETTINGS -->
<div class="overlay" id="settingsModal">
  <div class="modal">
    <div class="modal-head">
      <h3>Settings</h3>
      <button onclick="closeModal('settingsModal')">✕</button>
    </div>

    <div class="modal-body">

      <div class="setting">
        <div>
          <b>Dark mode</b>
          <div style="font-size:12px;color:#667781">Beddel muuqaalka</div>
        </div>
        <div class="switch" id="darkSwitch" onclick="toggleDark()"></div>
      </div>

      <div class="setting">
        <div>
          <b>Notifications</b>
          <div style="font-size:12px;color:#667781">Ogeysiisyada fariimaha</div>
        </div>
        <div class="switch on" id="notificationSwitch" onclick="toggleSetting('notifications')"></div>
      </div>

      <div class="setting">
        <div>
          <b>Message sound</b>
          <div style="font-size:12px;color:#667781">Cod marka fariin timaado</div>
        </div>
        <div class="switch on" id="soundSwitch" onclick="toggleSetting('sound')"></div>
      </div>

      <div class="setting">
        <div>
          <b>Enter to send</b>
          <div style="font-size:12px;color:#667781">Enter = dir fariinta</div>
        </div>
        <div class="switch on" id="enterSwitch" onclick="toggleSetting('enter')"></div>
      </div>

      <div class="setting">
        <div>
          <b>Auto reply demo</b>
          <div style="font-size:12px;color:#667781">Jawaab tijaabo ah</div>
        </div>
        <div class="switch on" id="autoSwitch" onclick="toggleSetting('auto')"></div>
      </div>

      <br>

      <button class="secondary" style="width:100%" onclick="changePIN()">
        🔐 Beddel PIN
      </button>

      <br><br>

      <button class="secondary" style="width:100%" onclick="exportData()">
        💾 Export data
      </button>

      <br><br>

      <button style="width:100%;padding:12px;background:#d93025;color:#fff;border-radius:7px"
              onclick="resetApp()">
        ⚠️ Reset App
      </button>

    </div>
  </div>
</div>

<!-- STATUS COMPOSER -->
<div class="overlay" id="statusModal">
  <div class="modal">
    <div class="modal-head">
      <h3>Add Status</h3>
      <button onclick="closeModal('statusModal')">✕</button>
    </div>

    <div class="modal-body">
      <textarea id="statusText" rows="5" placeholder="Maxaad rabtaa inaad status ka dhigto?"></textarea>

      <input type="color" id="statusColor" value="#00a884">

      <br><br>

      <button class="primary" onclick="addStatus()">Publish Status</button>
    </div>
  </div>
</div>

<!-- CALL -->
<div class="overlay" id="callModal">
  <div class="modal">
    <div class="modal-head">
      <h3 id="callTitle">Call</h3>
      <button onclick="endCall()">✕</button>
    </div>

    <div class="modal-body" style="text-align:center;padding:40px">
      <div class="big-avatar" id="callAvatar">?</div>
      <h2 id="callName">User</h2>
      <p id="callType">Calling...</p>

      <br>

      <button style="width:60px;height:60px;border-radius:50%;background:#d93025;color:white;font-size:25px"
              onclick="endCall()">📞</button>
    </div>
  </div>
</div>

<!-- CONTEXT MENU -->
<div class="menu" id="messageMenu">
  <button onclick="replyMessage()">↩️ Reply</button>
  <button onclick="copyMessage()">📋 Copy</button>
  <button onclick="forwardMessage()">↪️ Forward</button>
  <button onclick="deleteMessage()">🗑️ Delete</button>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   YUSUF CHAT
   One-file HTML + CSS + JavaScript
   Local/browser demo
========================================================= */

const KEY = "yusuf_chat_complete_v1";

let state = {
  user:{
    name:"",
    about:"Hey! I am using Yusuf Chat.",
    avatar:"",
    pin:""
  },

  settings:{
    dark:false,
    notifications:true,
    sound:true,
    enter:true,
    auto:true
  },

  contacts:[
    {
      id:"ahmed",
      name:"Ahmed",
      number:"+252 61 0000000",
      about:"Hello! I am using Yusuf Chat.",
      avatar:"",
      online:true,
      pinned:false,
      muted:false,
      messages:[
        {
          id:1,
          from:"them",
          text:"Salaan 👋",
          time:"10:20",
          status:"read"
        },
        {
          id:2,
          from:"me",
          text:"Wcs 👋 Sidee tahay?",
          time:"10:21",
          status:"read"
        },
        {
          id:3,
          from:"them",
          text:"Waan fiicanahay. Adiguna?",
          time:"10:22",
          status:"read"
        }
      ]
