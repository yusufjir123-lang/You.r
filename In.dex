    {
      id:"fatima",
      name:"Fatima",
      number:"+252 63 0000000",
      about:"Available",
      avatar:"",
      online:true,
      pinned:false,
      muted:false,
      messages:[
        {
          id:4,
          from:"them",
          text:"Hello 😊",
          time:"09:30",
          status:"read"
        }
      ]
    },

    {
      id:"cyber",
      name:"Cyber Study",
      number:"",
      about:"Cybersecurity group",
      avatar:"",
      online:false,
      pinned:true,
      muted:false,
      messages:[
        {
          id:5,
          from:"them",
          text:"Welcome to the study group 🔐",
          time:"Yesterday",
          status:"read"
        }
      ]
    }
  ],

  statuses:[
    {
      id:1,
      name:"My Status",
      text:"Ku soo dhawoow Yusuf Chat 👋",
      color:"#00a884",
      time:"Today"
    }
  ],

  calls:[],

  active:null,

  reply:null,

  selectedMessage:null
};

let mediaRecorder = null;
let audioChunks = [];
let recording = false;
let recordingSeconds = 0;
let recordingTimer = null;

function save(){
  localStorage.setItem(KEY,JSON.stringify(state));
}

function load(){
  try{
    const saved=localStorage.getItem(KEY);
    if(saved){
      const parsed=JSON.parse(saved);
      state={...state,...parsed};
      state.user={...state.user,...(parsed.user||{})};
      state.settings={...state.settings,...(parsed.settings||{})};
    }
  }catch(e){}
}

function $(id){
  return document.getElementById(id);
}

function toast(text){
  const t=$("toast");
  t.textContent=text;
  t.style.display="block";
  clearTimeout(window.toastTimer);
  window.toastTimer=setTimeout(()=>{
    t.style.display="none";
  },2200);
}

function initials(name){
  if(!name)return "?";
  return name
    .split(" ")
    .map(x=>x[0])
    .join("")
    .slice(0,2)
    .toUpperCase();
}

function avatarHTML(person){
  if(person.avatar){
    return `<img src="${person.avatar}">`;
  }
  return initials(person.name);
}

function startApp(){

  const name=$("loginName").value.trim();
  const pin=$("loginPin").value.trim();

  if(!name){
    toast("Fadlan geli magacaaga");
    return;
  }

  state.user.name=name;

  if(pin){
    state.user.pin=pin;
  }

  save();

  $("lockScreen").style.display="none";

  renderEverything();

  toast("Ku soo dhawoow "+name+" 👋");
}

function renderEverything(){
  renderMyAvatar();
  renderChats();
  applySettings();

  if(state.active){
    openChat(state.active);
  }
}

function renderMyAvatar(){

  const avatar=$("myAvatar");

  if(state.user.avatar){
    avatar.innerHTML=`<img src="${state.user.avatar}">`;
  }else{
    avatar.textContent=initials(state.user.name);
  }
}

function renderChats(){

  const list=$("sideList");

  const search=($("searchInput").value||"").toLowerCase();

  let contacts=[...state.contacts];

  contacts.sort((a,b)=>{
    if(a.pinned!==b.pinned)return a.pinned?-1:1;
    return 0;
  });

  contacts=contacts.filter(c=>
    c.name.toLowerCase().includes(search)
  );

  if(!contacts.length){
    list.innerHTML=`
      <div class="empty">
        <h3>Ma jiro contact</h3>
        <p>Riix ✏️ si aad qof ugu darto.</p>
      </div>
    `;
    return;
  }

  list.innerHTML=contacts.map(c=>{

    const last=c.messages?.[c.messages.length-1];

    return `
      <div class="chat-item ${state.active===c.id?"active":""}"
           onclick="openChat('${c.id}')">

        <div class="avatar">${avatarHTML(c)}</div>

        <div class="chat-info">

          <div class="chat-row">
            <div class="chat-name">
              ${escapeHTML(c.name)}
              ${c.pinned?" 📌":""}
              ${c.muted?" 🔕":""}
            </div>

            <div class="chat-time">
              ${last?last.time:""}
            </div>
          </div>

          <div class="last">
            ${last ? escapeHTML(
              last.text || last.fileName || "Attachment"
            ) : "No messages"}
          </div>

        </div>

      </div>
    `;
  }).join("");
}

function openChat(id){

  const c=state.contacts.find(x=>x.id===id);

  if(!c)return;

  state.active=id;

  $("app").classList.add("chat-open");

  $("headerName").textContent=c.name;
  $("headerStatus").textContent=
    c.online ? "online" : "last seen recently";

  $("headerAvatar").innerHTML=avatarHTML(c);

  renderMessages();
  renderChats();

  $("messageInput").focus();
}

function closeChat(){
  $("app").classList.remove("chat-open");
  state.active=null;
  renderChats();
}

function renderMessages(){

  const c=state.contacts.find(x=>x.id===state.active);
  const box=$("messages");

  if(!c){
    box.innerHTML=`
      <div class="empty">
        <h2>💬 Yusuf Chat</h2>
        <p>Dooro chat.</p>
      </div>`;
    return;
  }

  if(!c.messages || !c.messages.length){
    box.innerHTML=`
      <div class="day"><span>Today</span></div>
      <div class="empty">
        No messages yet.
      </div>
    `;
    return;
  }

  box.innerHTML=`
    <div class="day"><span>Today</span></div>
    ${c.messages.map(m=>messageHTML(m)).join("")}
  `;

  box.scrollTop=box.scrollHeight;
}

function messageHTML(m){

  const mine=m.from==="me";

  let content="";

  if(m.type==="image"){
    content=`
      <img class="msg-image"
           src="${m.data}"
           onclick="window.open(this.src)">
    `;
  }

  else if(m.type==="file"){
    content=`
      <div class="file-card">
        📄
        <div>
          <b>${escapeHTML(m.fileName||"File")}</b>
          <br>
          <small>Attachment</small>
        </div>
      </div>
    `;
  }

  else if(m.type==="audio"){
    content=`
      <audio controls style="max-width:230px">
        <source src="${m.data}">
      </audio>
    `;
  }

  else{
    content=`
      <div class="text">${escapeHTML(m.text||"")}</div>
    `;
  }

  const reply=m.reply
    ? `
      <div class="reply">
        <b>${escapeHTML(m.reply.name||"Message")}</b>
        ${escapeHTML(m.reply.text||"")}
      </div>
    `
    :"";

  return `
    <div class="message ${mine?"me":""}"
         ondblclick="selectMessage(${m.id})">

      <div class="bubble"
           oncontextmenu="showMessageMenu(event,${m.id});return false">

        ${reply}
        ${content}

        <div class="meta">
          ${m.time||""}

          ${mine ? `
            <span class="ticks ${m.status==="read"?"read":""}">
              ${m.status==="sent"?"✓":"✓✓"}
            </span>
          `:""}
        </div>

      </div>
    </div>
  `;
}

function escapeHTML(str){
  return String(str||"")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function nowTime(){

  return new Date().toLocaleTimeString(
    [],
    {
      hour:"2-digit",
      minute:"2-digit"
    }
  );
}

function sendMessage(){

  if(!state.active){
    toast("Marka hore dooro chat");
    return;
  }

  const input=$("messageInput");
  const text=input.value.trim();

  if(!text)return;

  const c=state.contacts.find(x=>x.id===state.active);

  const msg={
    id:Date.now(),
    from:"me",
    text:text,
    time:nowTime(),
    status:"sent"
  };

  if(state.reply){
    msg.reply={
      name:state.reply.from==="me"
        ? state.user.name
        : c.name,
      text:state.reply.text||""
    };
  }

  c.messages.push(msg);

  input.value="";
  cancelReply();

  save();
  renderMessages();
  renderChats();

  setTimeout(()=>{
    msg.status="delivered";
    save();
    renderMessages();
  },700);

  setTimeout(()=>{
    msg.status="read";
    save();
    renderMessages();
  },1500);

  if(state.settings.auto){

    setTimeout(()=>{

      if(state.active!==c.id)return;

      const replies=[
        "Haye 👍",
        "Waan helay fariintaada.",
        "Okay 😊",
        "Mahadsanid!",
        "Waan kula socdaa.",
        "Interesting 👌"
      ];

      const reply=replies[
        Math.floor(Math.random()*replies.length)
      ];

      c.messages.push({
        id:Date.now(),
        from:"them",
        text:reply,
        time:nowTime(),
        status:"read"
      });

      save();
      renderMessages();
      renderChats();

      if(state.settings.notifications){
        toast(c.name+": "+reply);
      }

    },1200);
  }
}

function handleEnter(e){

  if(e.key==="Enter" && !e.shiftKey && state.settings.enter){
    e.preventDefault();
    sendMessage();
  }
}

function toggleEmoji(){

  const panel=$("emojiPanel");

  if(panel.style.display==="block"){
    panel.style.display="none";
    return;
  }

  const emojis=[
    "😀","😃","😄","😁","😆","😅","😂","🤣",
    "😊","😇","🙂","🙃","😉","😌","😍","🥰",
    "😘","😎","🤩","🥳","😢","😭","😡","😱",
    "👍","👎","👏","🙏","❤️","💚","💙","🔥",
    "🎉","💯","✅","❌","⭐","💻","🔐","📱"
  ];

  panel.innerHTML=emojis.map(e=>
    `<button onclick="addEmoji('${e}')">${e}</button>`
  ).join("");

  panel.style.display="block";
}

function addEmoji(e){

  $("messageInput").value+=e;
  $("messageInput").focus();
}

function handleFiles(event){

  const files=[...event.target.files];

  if(!state.active){
    toast("Dooro chat marka hore");
    return;
  }

  files.forEach(file=>{

    const reader=new FileReader();

    reader.onload=()=>{

      const c=state.contacts.find(x=>x.id===state.active);

      if(file.type.startsWith("image/")){

        c.messages.push({
          id:Date.now()+Math.random(),
          from:"me",
          type:"image",
          data:reader.result,
          fileName:file.name,
          time:nowTime(),
          status:"read"
        });

      }else{

        c.messages.push({
          id:Date.now()+Math.random(),
          from:"me",
          type:"file",
          data:reader.result,
          fileName:file.name,
          time:nowTime(),
          status:"read"
        });
      }

      save();
      renderMessages();
      renderChats();
    };

    reader.readAsDataURL(file);
  });

  event.target.value="";
}

async function toggleRecording(){

  if(recording){
    stopRecording();
    return;
  }

  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    toast("Browser-kan ma taageerayo voice recording");
    return;
  }

  try{

    const stream=await navigator.mediaDevices.getUserMedia({
      audio:true
    });

    audioChunks=[];

    mediaRecorder=new MediaRecorder(stream);

    mediaRecorder.ondataavailable=e=>{
      if(e.data.size>0){
        audioChunks.push(e.data);
      }
    };

    mediaRecorder.onstop=()=>{

      const blob=new Blob(
        audioChunks,
        {type:"audio/webm"}
      );

      const reader=new FileReader();

      reader.onload=()=>{

        if(!state.active)return;

        const c=state.contacts.find(
          x=>x.id===state.active
        );

        c.messages.push({
          id:Date.now(),
          from:"me",
          type:"audio",
          data:reader.result,
          time:nowTime(),
          status:"read"
        });

        save();
        renderMessages();
        renderChats();
      };

      reader.readAsDataURL(blob);

      stream.getTracks().forEach(
        track=>track.stop()
      );
    };

    mediaRecorder.start();

    recording=true;
    recordingSeconds=0;

    $("recordButton").classList.add("recording");
    $("recordButton").textContent="⏹️";

    recordingTimer=setInterval(()=>{

      recordingSeconds++;

      if(recordingSeconds>=60){
        stopRecording();
      }

    },1000);

    toast("Recording...");

  }catch(e){
    toast("Microphone permission waa la diiday");
  }
}

function stopRecording(){

  if(mediaRecorder && recording){
    mediaRecorder.stop();
  }

  recording=false;

  clearInterval(recordingTimer);

  $("recordButton").classList.remove("recording");
  $("recordButton").textContent="🎙️";
}

function selectMessage(id){
  state.selectedMessage=id;
  toast("Fariinta waa la doortay");
}

function showMessageMenu(e,id){

  state.selectedMessage=id;

  const menu=$("messageMenu");

  menu.style.display="block";

  menu.style.left=Math.min(
    e.clientX,
    window.innerWidth-200
  )+"px";

  menu.style.top=Math.min(
    e.clientY,
    window.innerHeight-230
  )+"px";
}

function getSelectedMessage(){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c)return null;

  return c.messages.find(
    x=>x.id===state.selectedMessage
  );
}

function replyMessage(){

  const m=getSelectedMessage();

  if(!m)return;

  state.reply=m;

  $("replyText").textContent=
    m.text || m.fileName || "Attachment";

  $("replyBar").style.display="flex";

  $("messageMenu").style.display="none";

  $("messageInput").focus();
}

function cancelReply(){

  state.reply=null;

  $("replyBar").style.display="none";
}

function copyMessage(){

  const m=getSelectedMessage();

  if(!m)return;

  if(m.text){
    navigator.clipboard?.writeText(m.text);
    toast("Copied");
  }else{
    toast("Fariintan text ma aha");
  }

  $("messageMenu").style.display="none";
}

function forwardMessage(){

  const m=getSelectedMessage();

  if(!m)return;

  const target=state.contacts.find(
    x=>x.id!==state.active
  );

  if(!target){
    toast("Contact kale ma jiro");
    return;
  }

  target.messages.push({
    id:Date.now(),
    from:"me",
    text:m.text || "Forwarded attachment",
    time:nowTime(),
    status:"read"
  });

  save();

  $("messageMenu").style.display="none";

  toast("Fariinta waxaa loo forward gareeyay "+target.name);
}

function deleteMessage(){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c)return;

  c.messages=c.messages.filter(
    x=>x.id!==state.selectedMessage
  );

  save();

  renderMessages();

  $("messageMenu").style.display="none";

  toast("Fariinta waa la tirtiray");
}

function toggleChatMenu(){

  const menu=$("chatMenu");

  menu.style.display=
    menu.style.display==="block"
      ?"none"
      :"block";

  menu.style.right="15px";
  menu.style.top="65px";
}

function pinCurrent(){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c)return;

  c.pinned=!c.pinned;

  save();
  renderChats();

  $("chatMenu").style.display="none";

  toast(c.pinned?"Chat pinned":"Chat unpinned");
}

function muteCurrent(){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c)return;

  c.muted=!c.muted;

  save();
  renderChats();

  $("chatMenu").style.display="none";

  toast(c.muted?"Chat muted":"Chat unmuted");
}

function clearCurrent(){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c)return;

  if(confirm("Ma tirtirtaa dhammaan fariimaha chat-kan?")){

    c.messages=[];

    save();
    renderMessages();
    renderChats();

    $("chatMenu").style.display="none";

    toast("Messages cleared");
  }
}

function deleteCurrent(){

  if(!state.active)return;

  if(!confirm("Ma tirtirtaa chat-kan?"))return;

  state.contacts=state.contacts.filter(
    x=>x.id!==state.active
  );

  state.active=null;

  save();

  $("app").classList.remove("chat-open");

  renderChats();

  $("chatMenu").style.display="none";

  toast("Chat deleted");
}

function openNewChat(){

  $("newName").value="";
  $("newNumber").value="";
  $("newAbout").value="";

  $("newChatModal").style.display="flex";
}

function createContact(){

  const name=$("newName").value.trim();

  if(!name){
    toast("Magac geli");
    return;
  }

  const id=
    "user_"+Date.now();

  state.contacts.unshift({
    id:id,
    name:name,
    number:$("newNumber").value.trim(),
    about:$("newAbout").value.trim(),
    avatar:"",
    online:true,
    pinned:false,
    muted:false,
    messages:[]
  });

  save();

  closeModal("newChatModal");

  renderChats();

  openChat(id);

  toast("Contact added");
}

function showTab(tab,button){

  document.querySelectorAll(".tabs button")
    .forEach(b=>b.classList.remove("active"));

  button.classList.add("active");

  if(tab==="chats"){
    renderChats();
  }

  if(tab==="status"){
    renderStatus();
  }

  if(tab==="calls"){
    renderCalls();
  }
}

function renderStatus(){

  const list=$("sideList");

  list.innerHTML=`

    <div class="status-item" onclick="openStatusModal()">
      <div class="avatar">+</div>
      <div>
        <b>My Status</b>
        <div class="last">Add status update</div>
      </div>
    </div>

    <div style="padding:12px 15px;color:#667781;font-weight:bold">
      Recent updates
    </div>

    ${state.statuses.map(s=>`

      <div class="status-item"
           onclick="viewStatus(${s.id})">

        <div class="status-circle">
          <div class="avatar"
               style="background:${s.color}">
            ${initials(s.name)}
          </div>
        </div>

        <div>
          <b>${escapeHTML(s.name)}</b>
          <div class="last">${escapeHTML(s.text)}</div>
        </div>

      </div>

    `).join("")}
  `;
}

function openStatusModal(){
  $("statusModal").style.display="flex";
}

function addStatus(){

  const text=$("statusText").value.trim();

  if(!text){
    toast("Qor status");
    return;
  }

  state.statuses.unshift({
    id:Date.now(),
    name:"My Status",
    text:text,
    color:$("statusColor").value,
    time:"Now"
  });

  save();

  closeModal("statusModal");

  $("statusText").value="";

  toast("Status published");

  renderStatus();
}

function viewStatus(id){

  const s=state.statuses.find(x=>x.id===id);

  if(!s)return;

  alert(
    s.name+
    "\\n\\n"+
    s.text+
    "\\n\\n"+
    s.time
  );
}

function renderCalls(){

  const list=$("sideList");

  if(!state.calls.length){

    list.innerHTML=`
      <div class="empty">
        <h3>📞 No calls</h3>
        <p>Call history-ga halkan ayuu kasoo muuqanayaa.</p>
      </div>
    `;

    return;
  }

  list.innerHTML=state.calls.map(call=>`

    <div class="call-item">

      <div class="avatar">${initials(call.name)}</div>

      <div class="chat-info">
        <b>${escapeHTML(call.name)}</b>

        <div class="last">
          ${call.video?"📹":"📞"}
          ${call.incoming?"Incoming":"Outgoing"}
          · ${call.time}
        </div>
      </div>

      <div class="call-icon">
        ${call.video?"📹":"📞"}
      </div>

    </div>

  `).join("");
}

function startVoiceCall(){
  startCall(false);
}

function startVideoCall(){
  startCall(true);
}

function startCall(video){

  const c=state.contacts.find(
    x=>x.id===state.active
  );

  if(!c){
    toast("Dooro qof marka hore");
    return;
  }

  $("callName").textContent=c.name;
  $("callAvatar").innerHTML=avatarHTML(c);

  $("callType").textContent=
    video ? "Video calling..." : "Calling...";

  $("callTitle").textContent=
    video ? "📹 Video Call" : "📞 Voice Call";

  $("callModal").style.display="flex";

  state.calls.unshift({
    name:c.name,
    video:video,
    incoming:false,
    time:nowTime()
  });

  save();
}

function endCall(){

  closeModal("callModal");

  toast("Call ended");
}

function openProfile(){

  $("profileName").value=state.user.name;
  $("profileAbout").value=state.user.about;

  const a=$("profileAvatar");

  if(state.user.avatar){
    a.innerHTML=`<img src="${state.user.avatar}">`;
  }else{
    a.textContent=initials(state.user.name);
  }

  $("profileModal").style.display="flex";
}

function changeProfileImage(event){

  const file=event.target.files[0];

  if(!file)return;

  const reader=new FileReader();

  reader.onload=()=>{
    state.user.avatar=reader.result;

    const a=$("profileAvatar");

    a.innerHTML=`<img src="${reader.result}">`;
  };

  reader.readAsDataURL(file);
}

function saveProfile(){

  const name=$("profileName").value.trim();

  if(!name){
    toast("Magac geli");
    return;
  }

  state.user.name=name;
  state.user.about=$("profileAbout").value.trim();

  save();

  renderMyAvatar();

  closeModal("profileModal");

  toast("Profile saved");
}

function openSettings(){

  $("settingsModal").style.display="flex";

  updateSwitches();
}

function toggleDark(){

  state.settings.dark=!state.settings.dark;

  save();

  applySettings();
  updateSwitches();
}

function toggleSetting(key){

  state.settings[key]=!state.settings[key];

  save();

  updateSwitches();

  toast("Setting updated");
}

function updateSwitches(){

  const map={
    dark:"darkSwitch",
    notifications:"notificationSwitch",
    sound:"soundSwitch",
    enter:"enterSwitch",
    auto:"autoSwitch"
  };

  Object.keys(map).forEach(key=>{

    const el=$(map[key]);

    if(!el)return;

    el.classList.toggle(
      "on",
      !!state.settings[key]
    );
  });
}

function applySettings(){

  document.body.classList.toggle(
    "dark",
    !!state.settings.dark
  );
}

function changePIN(){

  const pin=prompt(
    "Geli PIN cusub (4-6 digits):"
  );

  if(pin===null)return;

  if(pin && !/^\d{4,6}$/.test(pin)){
    toast("PIN waa inuu noqdaa 4-6 numbers");
    return;
  }

  state.user.pin=pin;

  save();

  toast("PIN updated");
}

function exportData(){

  const data=JSON.stringify(
    state,
    null,
    2
  );

  const blob=new Blob(
    [data],
    {type:"application/json"}
  );

  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");

  a.href=url;
  a.download="yusuf-chat-backup.json";

  a.click();

  URL.revokeObjectURL(url);

  toast("Backup exported");
}

function resetApp(){

  if(!confirm(
    "Dhammaan data-ga Yusuf Chat waa la tirtirayaa. Sii wad?"
  ))return;

  localStorage.removeItem(KEY);

  location.reload();
}

function closeModal(id){
  $(id).style.display="none";
}

function searchChats(){
  renderChats();
}

/* Close menus when clicking elsewhere */
document.addEventListener("click",function(e){

  if(
    !e.target.closest("#chatMenu") &&
    !e.target.closest(".chat-header .icon")
  ){
    $("chatMenu").style.display="none";
  }

  if(
    !e.target.closest("#messageMenu") &&
    !e.target.closest(".bubble")
  ){
    $("messageMenu").style.display="none";
  }

  if(
    !e.target.closest("#emojiPanel") &&
    !e.target.closest(".input-area")
  ){
    $("emojiPanel").style.display="none";
  }
});

/* Escape closes overlays */
document.addEventListener("keydown",e=>{

  if(e.key==="Escape"){

    document.querySelectorAll(".overlay")
      .forEach(x=>x.style.display="none");

    $("chatMenu").style.display="none";
    $("messageMenu").style.display="none";
    $("emojiPanel").style.display="none";
  }
});

/* Start */
load();

if(state.user.name){

  $("lockScreen").style.display="none";

  renderEverything();

}else{

  $("lockScreen").style.display="flex";
}
</script>

</body>
</html>
